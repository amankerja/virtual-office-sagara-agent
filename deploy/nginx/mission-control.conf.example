# ==============================================================================
# Sagara Mission Control — Fallback Ingress Architecture (Nginx Reverse Proxy)
# Use ONLY if Cloudflare Tunnel cannot be utilized and explicitly approved.
# Invariants: Port 8000 remains 127.0.0.1 loopback only.
# ==============================================================================

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name control.example.com;

    return 301 https://$host$request_uri;
}

# HTTPS Server with Trusted Auth Boundary
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name control.example.com;

    # SSL Configuration (Certbot / Custom CA)
    ssl_certificate /etc/letsencrypt/live/control.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/control.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Trusted Identity Authentication Gateway (e.g. auth_request module)
    # auth_request /auth_verify;
    # location = /auth_verify {
    #     internal;
    #     proxy_pass http://127.0.0.1:9091/api/verify;
    #     proxy_pass_request_body off;
    #     proxy_set_header Content-Length "";
    #     proxy_set_header X-Original-URI $request_uri;
    # }

    # Reverse proxy to private loopback Mission Control
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # WebSocket & Long-lived streams
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Forwarded headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Ingress header sanitation: Strip any client-supplied spoofed identity headers
        proxy_set_header X-Operator-ID "";
        proxy_set_header X-Operator-Roles "";
        proxy_set_header X-Auth-Source "";

        # Authoritative identity injection from verified auth_request
        # auth_request_set $user $upstream_http_remote_user;
        # proxy_set_header X-Operator-ID $user;
        # proxy_set_header X-Auth-Source "trusted_proxy";

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
