[Unit]
Description=Cloudflare Tunnel for Sagara Mission Control Ingress
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --config /etc/cloudflared/config.yml sagara-mission-control
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=20s

# Security Sandboxing
User=cloudflared
Group=cloudflared
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/cloudflared
ReadOnlyPaths=/etc/cloudflared
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
