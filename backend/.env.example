# Sagara Mission Control Backend Configuration
MISSION_CONTROL_ENVIRONMENT=development
MISSION_CONTROL_DATA_MODE=mock
MISSION_CONTROL_HOST=127.0.0.1
MISSION_CONTROL_PORT=8000
MISSION_CONTROL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Prompt 09: Domain Source Control (Hybrid Read-Only Integration)
MISSION_CONTROL_PROFILE_SOURCE=mock
MISSION_CONTROL_SKILL_SOURCE=mock
MISSION_CONTROL_RUNTIME_SOURCE=mock

# Sagara Canonical Project Root (Absolute directory path, treated strictly read-only)
# Example: MISSION_CONTROL_SAGARA_PROJECT_ROOT=/path/to/sagara-agent
MISSION_CONTROL_SAGARA_PROJECT_ROOT=

# Mission Control Persistent Database (Prompt 13 Control Plane)
# SQLite WAL mode, foreign keys ON. Must NOT point to ~/.hermes/state.db
MISSION_CONTROL_DATABASE_URL=sqlite:///./data/mission-control.db

# Mission Control Action Signing Key (Server-side HMAC-SHA256)
# Required in production mode. Never commit or leak actual secrets.
MISSION_CONTROL_ACTION_SIGNING_KEY=change-this-in-production-to-a-secure-random-secret
